  ],
  "category": "64f1a2b3c4d5e6f7g8h9i0j4",
  "price": 1999.99,
  "rating": 0,
  "reviews": [],
  "features": [
    "M3 chip",
    "14-inch display",
    "16GB RAM"
  ],
  "specifications": {
    "storage": "512GB SSD",
    "memory": "16GB unified memory",
    "display": "14-inch Liquid Retina XDR"
  },
  "inStock": true,
